              "config": {
                "script": "\t# Get uploaded file\n\tupload \u003d self.parent.getChild(\"excelUpload\")\n\tif not upload.props.value or len(upload.props.value) \u003d\u003d 0:\n\t    system.perspective.openPopup(\n\t        id\u003d\"uploadErrorPopup\",\n\t        view\u003d\"ErrorPopup\",\n\t        params\u003d{\"display\": \"Please upload an Excel file first.\"},\n\t        title\u003d\"Error\",\n\t        modal\u003dTrue\n\t    )\n\t    return\n\t\n\tfile_data \u003d upload.props.value[0]\n\texcel_bytes \u003d file_data[\u0027data\u0027]\n\t\n\t# Parse Excel\n\tfrom org.apache.poi.ss.usermodel import WorkbookFactory\n\tfrom java.io import ByteArrayInputStream\n\t\n\tinput_stream \u003d ByteArrayInputStream(excel_bytes)\n\tworkbook \u003d WorkbookFactory.create(input_stream)\n\tsheet \u003d workbook.getSheetAt(0)\n\t\n\texpected_headers \u003d [\"Site\", \"Area\", \"Line\", \"Machine\", \"Instance name\", \"MQTT Engine Path\", \"Machine Model\"]\n\t\n\t# Find column indexes\n\theader_row \u003d sheet.getRow(0)\n\tcol_index \u003d {}\n\tfor idx, cell in enumerate(header_row):\n\t    cell_value \u003d cell.toString().strip()\n\t    for h in expected_headers:\n\t        if cell_value.lower() \u003d\u003d h.lower():\n\t            col_index[h] \u003d idx\n\t            break\n\t\n\tmissing \u003d [h for h in expected_headers if h not in col_index]\n\tif missing:\n\t    system.perspective.openPopup(\n\t        id\u003d\"missingColumnsPopup\",\n\t        view\u003d\"ErrorPopup\",\n\t        params\u003d{\"display\": \"Missing columns: \" + \", \".join(missing)},\n\t        title\u003d\"Error\",\n\t        modal\u003dTrue\n\t    )\n\t    return\n\t\n\tdef get_cell_value(row, col):\n\t    cell \u003d row.getCell(col)\n\t    if cell is None:\n\t        return \"\"\n\t    if cell.getCellType() \u003d\u003d 0:  # numeric\n\t        val \u003d cell.getNumericCellValue()\n\t        return str(int(val)) if val \u003d\u003d int(val) else str(val)\n\t    return cell.toString().strip()\n\t\n\tcreated \u003d []\n\terrors \u003d []\n\t\n\tfor row_idx in range(1, sheet.getLastRowNum() + 1):\n\t    row \u003d sheet.getRow(row_idx)\n\t    if row is None:\n\t        continue\n\t\n\t    site \u003d get_cell_value(row, col_index[\"Site\"])\n\t    area \u003d get_cell_value(row, col_index[\"Area\"])\n\t    line \u003d get_cell_value(row, col_index[\"Line\"])\n\t    machine \u003d get_cell_value(row, col_index[\"Machine\"])\n\t    instance_name \u003d get_cell_value(row, col_index[\"Instance name\"])\n\t    mqtt_path \u003d get_cell_value(row, col_index[\"MQTT Engine Path\"])\n\t    machine_model \u003d get_cell_value(row, col_index[\"Machine Model\"])\n\t\n\t    # --- Validate all fields present ---\n\t    missing_fields \u003d []\n\t    if not site: missing_fields.append(\"Site\")\n\t    if not area: missing_fields.append(\"Area\")\n\t    if not line: missing_fields.append(\"Line\")\n\t    if not machine: missing_fields.append(\"Machine\")\n\t    if not instance_name: missing_fields.append(\"Instance name\")\n\t    if not mqtt_path: missing_fields.append(\"MQTT Engine Path\")\n\t    if not machine_model: missing_fields.append(\"Machine Model\")\n\t    if missing_fields:\n\t        errors.append(\"Row {}: Missing: {}\".format(row_idx+1, \", \".join(missing_fields)))\n\t        continue\n\t\n\t    # --- Clean strings for tag path ---\n\t    def clean(s):\n\t        return s.strip().replace(\" \", \"_\")\n\t    \n\t    site_clean \u003d clean(site)\n\t    area_clean \u003d clean(area)\n\t    line_clean \u003d clean(line)\n\t    machine_clean \u003d clean(machine)\n\t    instance_name_clean \u003d clean(instance_name)\n\t    \n\t    target_folder \u003d \"[UNS]Pharma/{}/{}/{}/{}\".format(site_clean, area_clean, line_clean, machine_clean)\n\t    full_instance_path \u003d \"{}/{}\".format(target_folder, instance_name_clean)\n\t    \n\t    # --- Check if instance already exists ---\n\t    if system.tag.exists(full_instance_path):\n\t        errors.append(\"Row {}: Instance \u0027{}\u0027 already exists at {}\".format(row_idx+1, instance_name_clean, target_folder))\n\t        continue\n\t\n\t    # --- Validate MQTT Engine Path exists as a tag ---\n\t    if not system.tag.exists(mqtt_path):\n\t        errors.append(\"Row {}: MQTT Engine Path \u0027{}\u0027 does not exist\".format(row_idx+1, mqtt_path))\n\t        continue\n\t\n\t    # --- Validate UDT type exists under [UNS]_types_/ ---\n\t    udt_type_path \u003d \"[UNS]_types_/{}\".format(machine_model)\n\t    if not system.tag.exists(udt_type_path):\n\t        errors.append(\"Row {}: UDT type \u0027{}\u0027 not found at {}\".format(row_idx+1, machine_model, udt_type_path))\n\t        continue\n\t\n\t    # --- Create UDT instance ---\n\t    try:\n\t        config \u003d {\n\t            \"name\": instance_name_clean,\n\t            \"path\": full_instance_path,\n\t            \"typeId\": udt_type_path,\n\t            \"valueSource\": \"udt\",\n\t            \"parameters\": {\n\t                \"source\": mqtt_path\n\t            }\n\t        }\n\t        system.tag.configure(full_instance_path, config)\n\t        created.append(\"Row {}: Created {} with source\u003d{}\".format(row_idx+1, full_instance_path, mqtt_path))\n\t    except Exception as e:\n\t        errors.append(\"Row {}: Failed - {}\".format(row_idx+1, str(e)))\n\t\n\tworkbook.close()\n\t\n\t# --- Build summary message ---\n\tsummary_message \u003d \"Created: {}\\nErrors: {}\".format(len(created), len(errors))\n\tif errors:\n\t    summary_message +\u003d \"\\n\\nErrors:\\n\" + \"\\n\".join(errors[:10])\n\t    if len(errors) \u003e 10:\n\t        summary_message +\u003d \"\\n... and {} more\".format(len(errors)-10)\n\tif created:\n\t    summary_message +\u003d \"\\n\\nCreated:\\n\" + \"\\n\".join(created[:5])\n\t    if len(created) \u003e 5:\n\t        summary_message +\u003d \"\\n... and {} more\".format(len(created)-5)\n\t\n\t# Show final summary in popup\n\tif errors:\n\t    popup_title \u003d \"Completed with Errors\"\n\telse:\n\t    popup_title \u003d \"Success\"\n\t\n\tsystem.perspective.openPopup(\n\t    id\u003d\"summaryPopup\",\n\t    view\u003d\"ErrorPopup\",\n\t    params\u003d{\"display\": summary_message},\n\t    title\u003dpopup_title,\n\t    modal\u003dTrue\n\t)"
