            "onFileReceived": {
              "config": {
                "script": "\t# onFileReceived Event Script\n\t\n\t# Load the file\u0027s bytes\n\tfileBytes \u003d event.file.getBytes()\n\tfilename \u003d event.file.name\n\t\n\t# Use Apache POI to read the Excel file\n\tfrom org.apache.poi.ss.usermodel import WorkbookFactory\n\tfrom java.io import ByteArrayInputStream\n\t\n\tinput_stream \u003d ByteArrayInputStream(fileBytes)\n\tworkbook \u003d WorkbookFactory.create(input_stream)\n\tsheet \u003d workbook.getSheetAt(0)\n\t\n\t# --- Read headers ---\n\theader_row \u003d sheet.getRow(0)\n\tif header_row is None:\n\t    workbook.close()\n\t    return\n\t\n\tcolCount \u003d header_row.getLastCellNum()\n\theaders \u003d []\n\tfor col in range(colCount):\n\t    cell \u003d header_row.getCell(col)\n\t    if cell:\n\t        headers.append(cell.toString().strip())\n\t    else:\n\t        headers.append(\"Column_{}\".format(col))\n\t\n\t# --- Read data rows ---\n\tdata \u003d []        # list of rows (each row is a list of values)\n\tfor rowIdx in range(1, sheet.getLastRowNum() + 1):\n\t    row \u003d sheet.getRow(rowIdx)\n\t    if row is None:\n\t        continue\n\t\n\t    rowData \u003d []\n\t    for col in range(colCount):\n\t        cell \u003d row.getCell(col)\n\t        if cell is None:\n\t            rowData.append(\"\")\n\t        elif cell.getCellType() \u003d\u003d 0:   # numeric cell\n\t            val \u003d cell.getNumericCellValue()\n\t            # if value is an integer, store it as int, else as float\n\t            if val \u003d\u003d int(val):\n\t                rowData.append(int(val))\n\t            else:\n\t                rowData.append(val)\n\t        else:\n\t            rowData.append(cell.toString().strip())\n\t    data.append(rowData)\n\t\n\tworkbook.close()\n\t\n\t# --- Create the Ignition Dataset using system.dataset.toDataSet ---\n\tdataset \u003d system.dataset.toDataSet(headers, data)\n\t\n\t# --- Store dataset in the memory tag ---\n\tsystem.tag.writeBlocking(\"[UNS]UploadedExcelData\", dataset)\n\t\n\t# Optional: Log success message to the Gateway console\n\tsystem.perspective.print(\"File \u0027{}\u0027 processed successfully. Dataset has {} rows.\".format(filename, len(data)))"
              },
              "scope": "G",
              "type": "script"
            }
