                "script": "\t# ------------------------------------------------------------\n\t# Read dataset from tag\n\t# ------------------------------------------------------------\n\ttag_result \u003d system.tag.readBlocking(\"[UNS]UploadedExcelData\")\n\ttry:\n\t    dataset \u003d tag_result.value\n\texcept AttributeError:\n\t    dataset \u003d tag_result[0].value if len(tag_result) \u003e 0 else None\n\t\n\tif dataset is None or dataset.rowCount \u003d\u003d 0:\n\t    system.perspective.openPopup(id\u003d\"noDataPopup\", view\u003d\"ErrorPopup\",\n\t        params\u003d{\"display\": \"No Excel data found in [UNS]UploadedExcelData.\"},\n\t        title\u003d\"Error\", modal\u003dTrue)\n\t    return\n\t\n\t# ------------------------------------------------------------\n\t# Fixed column indices (0‑based, no header row)\n\t# ------------------------------------------------------------\n\tCOL_SITE \u003d 0\n\tCOL_AREA \u003d 1\n\tCOL_LINE \u003d 2\n\tCOL_MACHINE \u003d 3\n\tCOL_INSTANCE_NAME \u003d 4\n\tCOL_MQTT_PATH \u003d 5\n\tCOL_MODEL \u003d 6\n\t\n\tdef get_cell_value(row_idx, col_idx):\n\t    if col_idx \u003e\u003d dataset.columnCount:\n\t        return \"\"\n\t    val \u003d dataset.getValueAt(row_idx, col_idx)\n\t    if val is None:\n\t        return \"\"\n\t    if isinstance(val, (int, float)):\n\t        return str(int(val)) if val \u003d\u003d int(val) else str(val)\n\t    return str(val).strip()\n\t\n\t# ------------------------------------------------------------\n\t# Process each row\n\t# ------------------------------------------------------------\n\tcreated \u003d []\n\terrors \u003d []\n\t\n\tfor row_idx in range(dataset.rowCount):\n\t    site \u003d get_cell_value(row_idx, COL_SITE)\n\t    area \u003d get_cell_value(row_idx, COL_AREA)\n\t    line \u003d get_cell_value(row_idx, COL_LINE)\n\t    machine \u003d get_cell_value(row_idx, COL_MACHINE)\n\t    instance_name \u003d get_cell_value(row_idx, COL_INSTANCE_NAME)\n\t    mqtt_path \u003d get_cell_value(row_idx, COL_MQTT_PATH)\n\t    machine_model \u003d get_cell_value(row_idx, COL_MODEL)\n\t\n\t    # Skip empty rows\n\t    if not any([site, area, line, machine, instance_name, mqtt_path, machine_model]):\n\t        continue\n\t\n\t    # Validate required fields\n\t    missing \u003d []\n\t    if not site: missing.append(\"Site\")\n\t    if not area: missing.append(\"Area\")\n\t    if not line: missing.append(\"Line\")\n\t    if not machine: missing.append(\"Machine\")\n\t    if not instance_name: missing.append(\"Instance name\")\n\t    if not mqtt_path: missing.append(\"MQTT Engine Path\")\n\t    if not machine_model: missing.append(\"Machine Model\")\n\t    if missing:\n\t        errors.append(\"Row {}: Missing: {}\".format(row_idx+1, \", \".join(missing)))\n\t        continue\n\t\n\t    def clean(s):\n\t        return s.strip().replace(\" \", \"_\")\n\t\n\t    site_clean \u003d clean(site)\n\t    area_clean \u003d clean(area)\n\t    line_clean \u003d clean(line)\n\t    machine_clean \u003d clean(machine)\n\t    instance_name_clean \u003d clean(instance_name)\n\t\n\t    base_path \u003d \"[UNS]/Pharma/{}/{}/{}/{}\".format(site_clean, area_clean, line_clean, machine_clean)\n\t    instance_path \u003d \"{}/{}\".format(base_path, instance_name_clean)\n\t    udt_type_path \u003d \"[UNS]_types_/{}\".format(machine_model)\n\t\n\t    # Check duplicate\n\t    if system.tag.exists(instance_path):\n\t        errors.append(\"Row {}: Instance \u0027{}\u0027 already exists\".format(row_idx+1, instance_path))\n\t        continue\n\t\n\t    # Check source tag exists\n\t    if not system.tag.exists(mqtt_path):\n\t        errors.append(\"Row {}: MQTT path \u0027{}\u0027 does not exist\".format(row_idx+1, mqtt_path))\n\t        continue\n\t\n\t    # Check UDT type exists\n\t    if not system.tag.exists(udt_type_path):\n\t        errors.append(\"Row {}: UDT type \u0027{}\u0027 not found at {}\".format(row_idx+1, machine_model, udt_type_path))\n\t        continue\n\t\n\t    # Create UDT instance\n\t    try:\n\t        tag_definition \u003d {\n\t            \"name\": instance_name_clean,\n\t            \"tagType\": \"UdtInstance\",\n\t            \"typeId\": udt_type_path,\n\t            \"parameters\": {\n\t                \"site\": site,\n\t                \"area\": area,\n\t                \"line\": line,\n\t                \"machine\": machine,\n\t                \"source\": mqtt_path\n\t            }\n\t        }\n\t        system.tag.configure(base_path, [tag_definition])\n\t        created.append(\"Row {}: Created {}\".format(row_idx+1, instance_path))\n\t    except Exception as e:\n\t        errors.append(\"Row {}: Failed - {}\".format(row_idx+1, str(e)))\n\t\n\t# ------------------------------------------------------------\n\t# Clear the dataset tag after processing\n\t# ------------------------------------------------------------\n\tsystem.tag.writeBlocking(\"[UNS]UploadedExcelData\", None)\n\t\n\t# ------------------------------------------------------------\n\t# Build summary message with HTML line breaks\n\t# ------------------------------------------------------------\n\tsummary_message \u003d \"Created: {} Errors: {}\".format(len(created), len(errors))\n\tif errors:\n\t    summary_message +\u003d \"\u003cbr/\u003e\u003cbr/\u003eErrors:\u003cbr/\u003e\" + \"\u003cbr/\u003e\".join(errors[:10])\n\t    if len(errors) \u003e 10:\n\t        summary_message +\u003d \"\u003cbr/\u003e... and {} more\".format(len(errors)-10)\n\tif created:\n\t    summary_message +\u003d \"\u003cbr/\u003e\u003cbr/\u003eCreated:\u003cbr/\u003e\" + \"\u003cbr/\u003e\".join(created[:5])\n\t    if len(created) \u003e 5:\n\t        summary_message +\u003d \"\u003cbr/\u003e... and {} more\".format(len(created)-5)\n\t\n\tpopup_title \u003d \"Completed with Errors\" if errors else \"Success\"\n\tsystem.perspective.openPopup(\n\t    id\u003d\"summaryPopup\",\n\t    view\u003d\"ErrorPopup\",\n\t    params\u003d{\"display\": summary_message, \"html\": True},\n