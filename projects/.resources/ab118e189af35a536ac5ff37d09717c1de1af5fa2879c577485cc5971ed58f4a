                "script": "\t# Get values from the view\n\tmachine_type \u003d self.getSibling(\"Dropdown\").props.value\n\tsite \u003d self.getSibling(\"site\").props.text\n\tarea \u003d self.getSibling(\"area\").props.text\n\tline \u003d self.getSibling(\"line\").props.text\n\tmachine \u003d self.getSibling(\"machine\").props.text\n\tinstance_name \u003d self.getSibling(\"instance_name\").props.text\n\t\n\t# Get source tag path from Tag Browse Tree\n\tselection \u003d self.getSibling(\"TagBrowseTree\").props.selection.values\n\t\n\t# ---------------------------------------------------\n\t# VALIDATION\n\t# ---------------------------------------------------\n\t\n\tif not all([machine_type, site, area, line, machine, instance_name, selection]):\n\t\n\t    system.perspective.openPopup(\n\t        id\u003d\"validationPopup\",\n\t        view\u003d\"ErrorPopup\",\n\t        params\u003d{\n\t            \"display\": \"Please fill in all fields and select a source tag.\"\n\t        },\n\t        title\u003d\"Validation Error\",\n\t        modal\u003dTrue\n\t    )\n\t\n\t    return\n\t\n\t# ---------------------------------------------------\n\t# BUILD TAG PATH\n\t# ---------------------------------------------------\n\t\n\tuns_provider \u003d \"UNS\"\n\tsource_tag_path \u003d str(selection[0]) if selection else None\n\tfull_path \u003d \"[{}]/Pharma/{}/{}/{}\".format(\n\t    uns_provider,\n\t    site,\n\t    area,\n\t    line\n\t)\n\t\n\tudt_type_path \u003d machine_type\n\t\n\ttry:\n\t\n\t    # ---------------------------------------------------\n\t    # CREATE UDT INSTANCE\n\t    # ---------------------------------------------------\n\t\n\t    tag_definition \u003d {\n\t        \"name\": instance_name,\n\t        \"tagType\": \"UdtInstance\",\n\t        \"typeId\": udt_type_path,\n\t        \"parameters\": {\n\t            \"site\": site,\n\t            \"area\": area,\n\t            \"line\": line,\n\t            \"machine\": machine,\n\t            \"source\": str(source_tag_path)\n\t        }\n\t    }\n\t\n\t    system.tag.configure(full_path, [tag_definition])\n\t\n\t    # ---------------------------------------------------\n\t    # SUCCESS POPUP\n\t    # ---------------------------------------------------\n\t\n\t    system.perspective.openPopup(\n\t        id\u003d\"successPopup\",\n\t        view\u003d\"ErrorPopup\",\n\t        params\u003d{\n\t            \"display\": \"Machine \u0027{}\u0027 created successfully.\".format(instance_name)\n\t        },\n\t        title\u003d\"Success\",\n\t        modal\u003dTrue\n\t    )\n\t\n\texcept Exception as e:\n\t\n\t    # ---------------------------------------------------\n\t    # ERROR POPUP\n\t    # ---------------------------------------------------\n\t\n\t    system.perspective.openPopup(\n\t        id\u003d\"errorPopup\",\n\t        view\u003d\"ErrorPopup\",\n\t        params\u003d{\n\t            \"display\": \"Error creating machine: {}\".format(str(e))\n\t        },\n\t        title\u003d\"Error\",\n\t        modal\u003dTrue\n\t    )"
              },
