{
  "custom": {
    "exchange": {
      "historyProvider": "launchpad",
      "launchpad": {
        "dashboard": {
          "mobileBreakpoint": 1100,
          "objects": {
            "edit": {}
          },
          "options": {
            "overrideUsername": "admin",
            "url": ""
          }
        }
      }
    }
  },
  "propConfig": {
    "custom.exchange.launchpad.dashboard.dashboards": {
      "binding": {
        "config": {
          "path": "this.custom.exchange.launchpad.dashboard.options.username"
        },
        "transforms": [
          {
            "code": "\tvalue \u003d system.db.runNamedQuery(path\u003d\"Exchange/Launchpad/Dashboard/Get\", parameters\u003d{\"username\":value})\n\tvalue \u003d system.dataset.toPyDataSet(value)\n\treturn exchange.launchpad.dashboard.getDashboards(value)",
            "type": "script"
          }
        ],
        "type": "property"
      }
    },
    "custom.exchange.launchpad.dashboard.dbValid": {
      "binding": {
        "config": {
          "queryPath": "Exchange/Launchpad/Dashboard/DB Check"
        },
        "transforms": [
          {
            "code": "\treturn False if value \u003d\u003d None else value \u003d\u003d 1",
            "type": "script"
          }
        ],
        "type": "query"
      }
    },
    "custom.exchange.launchpad.dashboard.objects.current": {
      "binding": {
        "config": {
          "struct": {
            "dashboards": "{this.custom.exchange.launchpad.dashboard.dashboards}",
            "url": "{this.custom.exchange.launchpad.dashboard.options.url}"
          },
          "waitOnAll": true
        },
        "transforms": [
          {
            "code": "\turl \u003d value[\"url\"]\n\tdashboards \u003d value[\"dashboards\"]\n\treturn exchange.launchpad.dashboard.getCurrentDashboard(dashboards, url)",
            "type": "script"
          }
        ],
        "type": "expr-struct"
      }
    },
    "custom.exchange.launchpad.dashboard.objects.currentLastModified": {
      "binding": {
        "config": {
          "parameters": {
            "id": "{this.custom.exchange.launchpad.dashboard.objects.current.id}"
          },
          "polling": {
            "enabled": true,
            "rate": "30"
          },
          "queryPath": "Exchange/Launchpad/Dashboard/Last Modified"
        },
        "type": "query"
      }
    },
    "custom.exchange.launchpad.dashboard.options.isDesigner": {
      "binding": {
        "config": {
          "expression": "{this.props.device.type} \u003d \u0027designer\u0027"
        },
        "type": "expr"
      }
    },
    "custom.exchange.launchpad.dashboard.options.username": {
      "binding": {
        "config": {
          "expression": "if({this.custom.exchange.launchpad.dashboard.options.isDesigner}, \r\n{this.custom.exchange.launchpad.dashboard.options.overrideUsername},\r\n{this.props.auth.user.userName})"
        },
        "transforms": [
          {
            "code": "\treturn value if value else \u0027Anonymous\u0027",
            "type": "script"
          }
        ],
        "type": "expr"
      }
    },
    "props.auth": {
      "access": "PRIVATE",
      "persistent": false
    },
    "props.device.accelerometer": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.identifier": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.timezone": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.type": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.device.userAgent": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.gateway": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.geolocation.data": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.geolocation.permissionGranted": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.host": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.id": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.lastActivity": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.offline.capable": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.offline.enabled": {
      "access": "SYSTEM",
      "persistent": false
    },
    "props.offline.lastSynced": {
      "access": "SYSTEM",
      "persistent": false
    }
  },
  "props": {
    "address": "172.19.0.2",
    "appBar": {
      "togglePosition": "hidden"
    },
    "device": {},
    "geolocation": {},
    "locale": "fr-FR",
    "offline": {},
    "theme": "dark",
    "timeZoneId": "Africa/Tunis"
  }
}