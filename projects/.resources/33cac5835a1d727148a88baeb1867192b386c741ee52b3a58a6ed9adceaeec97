                    "script": "\t# ---------------------------------------------------\n\t# GET VALUES FROM VIEW\n\t# ---------------------------------------------------\n\tself.parent.parent.getChild(\"root\").getChild(\"Dropdown\").props.value\n\tmachine_type \u003d self.parent.parent.getChild(\"root\").getChild(\"Dropdown\").props.value\n\t#site \u003d self.parent.parent.getChild(\"root\").getChild(\"site\").props.text\n\tsite \u003d self.parent.parent.getChild(\"root\").getChild(\"Dropdown_site\").props.value\n\t#area \u003d self.parent.parent.getChild(\"root\").getChild(\"area\").props.text\n\tarea \u003d self.parent.parent.getChild(\"root\").getChild(\"Dropdown_area\").props.value\n\t#line \u003d self.parent.parent.getChild(\"root\").getChild(\"line\").props.text\n\tline \u003d self.parent.parent.getChild(\"root\").getChild(\"Dropdown_line\").props.value\n\tmachine \u003d self.parent.parent.getChild(\"root\").getChild(\"machine\").props.text\n\tinstance_name \u003d self.parent.parent.getChild(\"root\").getChild(\"instance_name\").props.text\n\t\n\tselection \u003d self.getSibling(\"TagBrowseTree\").props.selection.values\n\t\n\t# ---------------------------------------------------\n\t# VALIDATION\n\t# ---------------------------------------------------\n\t\n\tselection \u003d self.getSibling(\"TagBrowseTree\").props.selection.values\n\n\tif (\n\t    not machine_type or\n\t    not site or\n\t    not area or\n\t    not line or\n\t    not machine or\n\t    not instance_name or\n\t    not selection or\n\t    len(selection) \u003d\u003d 0\n\t):\n\t\n\t    system.perspective.openPopup(\n\t        id\u003d\"validationPopup\",\n\t        view\u003d\"ErrorPopup\",\n\t        params\u003d{\n\t            \"display\": \"Please fill in all fields and select a source tag.\"\n\t        },\n\t        title\u003d\"Error\",\n\t        modal\u003dTrue\n\t    )\n\t\n\t    return\n\t\n\t# ---------------------------------------------------\n\t# SAFE SOURCE TAG\n\t# ---------------------------------------------------\n\t\n\tsource_tag_path \u003d str(selection[0])\n\t\n\t# ---------------------------------------------------\n\t# BUILD PATH\n\t# ---------------------------------------------------\n\t\n\tuns_provider \u003d \"UNS\"\n\t\n\tbase_path \u003d \"[{}]/Pharma/{}/{}/{}/{}\".format(\n\t    uns_provider,\n\t    site,\n\t    area,\n\t    line,\n\t    machine\n\t)\n\t\n\tinstance_path \u003d \"{}/{}\".format(base_path, instance_name)\n\t\n\tudt_type_path \u003d machine_type\n\t\n\t# ---------------------------------------------------\n\t# CHECK DUPLICATE\n\t# ---------------------------------------------------\n\t\n\tif system.tag.exists(instance_path):\n\t\n\t    system.perspective.openPopup(\n\t        id\u003d\"duplicatePopup\",\n\t        view\u003d\"ErrorPopup\",\n\t        params\u003d{\n\t            \"display\": \"Machine \u0027{}\u0027 already exists in this location.\".format(instance_name)\n\t        },\n\t        title\u003d\"Duplicate Error\",\n\t        modal\u003dTrue\n\t    )\n\t\n\t    return\n\t\n\t# ---------------------------------------------------\n\t# CREATE UDT INSTANCE\n\t# ---------------------------------------------------\n\t\n\ttry:\n\t\n\t    tag_definition \u003d {\n\t        \"name\": instance_name,\n\t        \"tagType\": \"UdtInstance\",\n\t        \"typeId\": udt_type_path,\n\t        \"parameters\": {\n\t            \"site\": site,\n\t            \"area\": area,\n\t            \"line\": line,\n\t            \"machine\": machine,\n\t            \"source\": source_tag_path\n\t        }\n\t    }\n\t\n\t    system.tag.configure(base_path, [tag_definition])\n\t    self.getSibling(\"TagBrowseTree\").props.selection \u003d {\n    \t\"values\": []\n\t\t}\n\t\n\t    # ---------------------------------------------------\n\t    # SUCCESS POPUP\n\t    # ---------------------------------------------------\n\t\n\t    system.perspective.openPopup(\n\t        id\u003d\"validationPopup\",\n\t        view\u003d\"ValidationPopup\",\n\t        params\u003d{\n\t            \"instance_path\": instance_path\n\t        },\n\t        title\u003d\"Validation\",\n\t        modal\u003dTrue\n\t    )\n\t\n\texcept Exception as e:\n\t\n\t    # ---------------------------------------------------\n\t    # ERROR POPUP\n\t    # ---------------------------------------------------\n\t\n\t    system.perspective.openPopup(\n\t        id\u003d\"errorPopup\",\n\t        view\u003d\"ErrorPopup\",\n\t        params\u003d{\n\t            \"display\": \"Error creating machine: {}\".format(str(e))\n\t        },\n\t        title\u003d\"Error\",\n\t        modal\u003dTrue\n\t    )"
