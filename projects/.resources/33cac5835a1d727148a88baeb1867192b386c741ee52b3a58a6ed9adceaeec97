                "onActionPerformed": {
                  "config": {
                    "script": "# ------------------------------------------------------------\n# Read dataset from tag\n# ------------------------------------------------------------\ntag_result \u003d system.tag.readBlocking(\"[UNS]UploadedExcelData\")\ntry:\n    dataset \u003d tag_result.value\nexcept AttributeError:\n    dataset \u003d tag_result[0].value if len(tag_result) \u003e 0 else None\n\nif dataset is None or dataset.rowCount \u003d\u003d 0:\n    system.perspective.openPopup(id\u003d\"noDataPopup\", view\u003d\"ErrorPopup\",\n        params\u003d{\"display\": \"No Excel data found in [UNS]UploadedExcelData.\"},\n        title\u003d\"Error\", modal\u003dTrue)\n    return\n\n# ------------------------------------------------------------\n# Fixed column indices (0‑based, no header row)\n# ------------------------------------------------------------\nCOL_SITE \u003d 0\nCOL_AREA \u003d 1\nCOL_LINE \u003d 2\nCOL_MACHINE \u003d 3          # folder name under Line\nCOL_INSTANCE_NAME \u003d 4    # UDT instance name\nCOL_MQTT_PATH \u003d 5        # source tag path\nCOL_MODEL \u003d 6            # UDT type name (e.g. \"AKTA_Chromatography\")\n\ndef get_cell_value(row_idx, col_idx):\n    if col_idx \u003e\u003d dataset.columnCount:\n        return \"\"\n    val \u003d dataset.getValueAt(row_idx, col_idx)\n    if val is None:\n        return \"\"\n    if isinstance(val, (int, float)):\n        return str(int(val)) if val \u003d\u003d int(val) else str(val)\n    return str(val).strip()\n\n# ------------------------------------------------------------\n# Process each row\n# ------------------------------------------------------------\ncreated \u003d []\nerrors \u003d []\ndebug_rows \u003d []   # store first few rows for debug\n\nfor row_idx in range(dataset.rowCount):\n    site \u003d get_cell_value(row_idx, COL_SITE)\n    area \u003d get_cell_value(row_idx, COL_AREA)\n    line \u003d get_cell_value(row_idx, COL_LINE)\n    machine \u003d get_cell_value(row_idx, COL_MACH