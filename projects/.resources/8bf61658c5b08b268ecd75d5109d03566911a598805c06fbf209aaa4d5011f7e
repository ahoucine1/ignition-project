onPopup\",\n\t        params\u003d{\n\t            \"instance_path\": instance_path\n\t        },\n\t        title\u003d\"Validation\",\n\t        modal\u003dTrue\n\t    )\n\t\n\texcept Exception as e:\n\t\n\t    # ---------------------------------------------------\n\t    # ERROR POPUP\n\t    # ---------------------------------------------------\n\t\n\t    system.perspective.openPopup(\n\t        id\u003d\"errorPopup\",\n\t        view\u003d\"ErrorPopup\",\n\t        params\u003d{\n\t            \"display\": \"Error creating machine: {}\".format(str(e))\n\t        },\n\t        title\u003d\"Error\",\n\t        modal\u003dTrue\n\t    )"
