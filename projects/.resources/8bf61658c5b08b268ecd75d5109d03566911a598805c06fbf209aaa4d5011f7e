                    "script": "\t# ------------------------------------------------------------\n\t# Get the dataset from the tag\n\t# ------------------------------------------------------------\n\tdataset \u003d system.tag.readBlocking(\"[UNS]UploadedExcelData\").value\n\t\n\tif dataset is None or dataset.rowCount \u003d\u003d 0:\n\t    system.perspective.openPopup(\n\t        id\u003d\"noDataPopup\",\n\t        view\u003d\"ErrorPopup\",\n\t        params\u003d{\"display\": \"No Excel data found in [UNS]UploadedExcelData. Please upload a file first.\"},\n\t        title\u003d\"Error\", modal\u003dTrue\n\t    )\n\t    return\n\t\n\t# ------------------------------------------------------------\n\t# Expected headers\n\t# ------------------------------------------------------------\n\texpected_headers \u003d [\"Site\", \"Area\", \"Line\", \"Machine\", \"Instance name\", \"MQTT Engine Path\", \"Machine Model\"]\n\t\n\t# Get header row (first row of dataset)\n\theader_row \u003d [dataset.getValueAt(0, col) for col in range(dataset.columnCount)]\n\t\n\t# Find column indexes\n\tcol_index \u003d {}\n\tfor idx, header in enumerate(header_row):\n\t    header_str \u003d str(header).strip()\n\t    for h in expected_headers:\n\t        if header_str.lower() \u003d\u003d h.lower():\n\t            col_index[h] \u003d idx\n\t            break\n\t\n\tmissing \u003d [h for h in expected_headers if h not in col_index]\n\tif missing:\n\t    system.perspective.openPopup(\n\t        id\u003d\"missingColumnsPopup\", view\u003d\"ErrorPopup\",\n\t        params\u003d{\"display\": \"Missing columns: \" + \", \".join(missing)},\n\t        title\u003d\"Error\", modal\u003dTrue\n\t    )\n\t    return\n\t\n\t# ------------------------------------------------------------\n\t# Process rows (start from row 1, skip header)\n\t# ------------------------------------------------------------\n\tcreated \u003d []\n\terrors \u003d []\n\t\n\tdef get_cell_value(row_idx, col_idx):\n\t    val \u003d dataset