                  "type": "expr"
                }
              }
            },
            "props": {
              "style": {
                "classes": "exchange/launchpad/kpi/text/number"
              }
            },
            "type": "ia.display.label"
          },
          {
            "meta": {
              "name": "Units"
            },
            "position": {
              "shrink": 0
            },
            "propConfig": {
              "props.text": {
                "binding": {
                  "config": {
                    "fallbackDelay": 2.5,
                    "mode": "indirect",
                    "references": {
                      "realtimePath": "{view.custom.realtimePath}"
                    },
                    "tagPath": "{realtimePath}.engUnit"
                  },
                  "type": "tag"
                }
              }
            },
            "props": {
              "style": {
                "classes": "exchange/launchpad/kpi/text/units"
              }
            },
            "type": "ia.display.label"
          }
        ],
        "meta": {
          "name": "ValueAndUnits"
        },
        "position": {
          "shrink": 0
        },
        "props": {
          "style": {
            "column-gap": "10px",
            "row-gap": "0px"
          },
          "wrap": "wrap"
        },
        "type": "ia.container.flex"
      },
      {
        "meta": {
          "name": "Sparkline"
        },
        "position": {
          "grow": 1
        },
        "propConfig": {
          "custom.range": {
            "binding": {
              "config": {
                "path": "view.custom.sparklinePoints"
              },
              "transforms": [
                {
                  "code": "\tminVal \u003d min(value)\n\tmaxVal \u003d max(value)\n\t\n\tif minVal !\u003d None and maxVal !\u003d None:\n\t\tif minVal !\u003d maxVal:\n\t\t\treturn {\u0027low\u0027: minVal, \u0027high\u0027: maxVal}\n\t\telse:\n\t\t\treturn {\u0027low\u0027: minVal * 0.50, \u0027high\u0027: maxVal * 1.50}\n\telse:\n\t\treturn {\u0027low\u0027: \u0027\u0027, \u0027high\u0027: \u0027\u0027}",
                  "type": "script"
                }
              ],
              "type": "property"
            }
          },
          "props.points": {
            "binding": {
              "config": {
                "path": "view.custom.sparklinePoints"
              },
              "type": "property"
            }
          },
          "props.range": {
            "binding": {
              "config": {
                "path": "this.custom.range"
              },
              "type": "property"
            }
          }
        },
        "props": {
          "color": "var(--kpi-primary)",
          "marker": {
            "first": {
              "size": 0
            },
            "high": {
              "size": 0
            },
            "last": {
              "size": 0
            },
            "low": {
              "size": 0
            }
          },
          "style": {
            "marginTop": "6px"
          },
          "width": 2
        },
        "type": "ia.display.sparkline"
      }
    ],
    "events": {
      "dom": {
        "onClick": {
          "config": {
            "script": "\tviewPath \u003d \u0027Exchange/Launchpad/Kpi/EmbeddedViews/Popup\u0027\n\tviewParams \u003d {\u0027path\u0027: self.view.custom.realtimePath, \u0027historyProvider\u0027: self.session.custom.exchange.historyProvider}\n\tpopupTitle \u003d \u0027Historical Data\u0027\n\texchange.launchpad.util.popup(self, viewPath, viewParams, popupTitle)"
          },
          "scope": "G",
          "type": "script"
        }
      }
    },
    "meta": {
      "name": "root"
    },
    "props": {
      "direction": "column",
      "style": {
        "classes": "exchange/launchpad/kpi/card-small",
        "cursor": "pointer",
        "gap": "0px",
        "overflow": "hidden"
      }
    },
    "type": "ia.container.flex"
  }
