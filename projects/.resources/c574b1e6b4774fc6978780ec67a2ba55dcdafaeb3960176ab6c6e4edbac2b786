                          "code": "\n\n    try:\n        # ---------------------------------\n        # 1. Validate input\n        # ---------------------------------\n        if not value or len(value) \u003d\u003d 0:\n            return \"select machine\"\n\n        path \u003d str(value[0])\n\n        if not path:\n            return \"select machine\"\n\n        # ---------------------------------\n        # 2. Read source parameter\n        # ---------------------------------\n        source_result \u003d system.tag.readBlocking(\n            [path + \"/Parameters.source\"]\n        )[0]\n\n        source \u003d source_result.value\n\n        if not source:\n            return \"select machine\"\n\n        # ---------------------------------\n        # 3. Remove last node\n        # ---------------------------------\n        base_path \u003d source.rsplit(\"/\", 1)[0]\n\n        # ---------------------------------\n        # 4. Remove MQTT Engine prefix\n        # ---------------------------------\n        prefix \u003d \"[MQTT Engine]Edge Nodes/\"\n\n        if not base_path.startswith(prefix):\n            return \"invalid source format\"\n\n        mqtt_path \u003d base_path[len(prefix):]\n\n        # ---------------------------------\n        # 5. Transform path\n        # ---------------------------------\n        parts \u003d mqtt_path.split(\"/\")\n\n        if len(parts) \u003c 3:\n            return \"invalid mqtt path\"\n\n        group_id \u003d parts[0]\n        node_id \u003d parts[1]\n        device_id \u003d parts[2]\n\n        transformed_path \u003d \"spBv1.0/{}/DDATA/{}/{}\".format(\n            group_id,\n            node_id,\n            device_id\n        )\n\n        # ---------------------------------\n        # 6. Search wrapper.log\n        # Ubuntu path\n        # ---------------------------------\n        log_file \u003d \"/usr/local/bin/ignition/logs/wrapper.log\"\n\n        last_match \u003d \"no log found\"\n\n        try:\n\n            with open(log_file, \"r\") as f:\n\n                for line in f:\n\n                    if transformed_path in line:\n                        last_match \u003d line.strip()\n\n        except Exception as e:\n            return \"log read error: {}\".format(str(e))\n\n        # ---------------------------------\n        # 7. Return result\n        # ---------------------------------\n        return last_match\n\n    except:\n        return \"select machine\"",
