                          "code": "\n    try:\n        path \u003d str(value[0])\n\n        # Read UDT parameter\n        source \u003d system.tag.readBlocking([path + \"/Parameters.source\"])[0].value\n\n        if not source:\n            return \"select machine\"\n\n        # Remove last part of source (machine node)\n        base_path \u003d source.rsplit(\"/\", 1)[0]\n\n        # -----------------------------\n        # 1. Check Online status\n        # -----------------------------\n        online_path \u003d base_path + \"/Device Info/Online\"\n        online \u003d system.tag.readBlocking([online_path])[0].value\n\n        # -----------------------------\n        # 2. Count received (good) tags\n        # -----------------------------\n        def count_good_tags(p):\n            good \u003d 0\n            total \u003d 0\n\n            try:\n                children \u003d system.tag.browse(p)\n\n                for child in children:\n                    tag_type \u003d str(child[\u0027tagType\u0027])\n                    full_path \u003d str(child[\u0027fullPath\u0027])\n\n                    if tag_type \u003d\u003d \u0027AtomicTag\u0027:\n                        total +\u003d 1\n\n                        try:\n                            q \u003d system.tag.readBlocking([full_path])[0].quality\n                            if q.isGood():\n                                good +\u003d 1\n                        except:\n                            pass\n\n                    elif tag_type in (\u0027Folder\u0027, \u0027UDT\u0027, \u0027UdtInstance\u0027, \u0027UDT Instance\u0027):\n                        g, t \u003d count_good_tags(full_path)\n                        good +\u003d g\n                        total +\u003d t\n\n            except:\n                pass\n\n            return good, total\n\n        received, total \u003d count_good_tags(path)\n\n        # -----------------------------\n        # 3. Return logic\n        # -----------------------------\n        # You can choose what to return:\n        return \"{}/{}\".format(received, total)  # only received tags count\n\n        # OR if you want richer output:\n        # return \"online: {}, received: {}/{}\".format(online, received, total)\n\n    except:\n        return \"select machine\"",
